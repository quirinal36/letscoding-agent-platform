{
  "schemaVersion": 1,
  "id": "lounge-deploy",
  "version": "2026-08-12.1",
  "effectiveAt": "2026-08-12T00:00:00Z",
  "changeReason": "정책 계약 도입에 따른 최초 스냅샷 발행.",
  "zip": {
    "maxCompressedBytes": 31457280,
    "maxUncompressedBytes": 104857600,
    "maxFiles": 500,
    "requireRootIndexHtml": true,
    "codes": {
      "compressedTooLarge": "LD_ZIP_COMPRESSED_TOO_LARGE",
      "uncompressedTooLarge": "LD_ZIP_UNCOMPRESSED_TOO_LARGE",
      "tooManyFiles": "LD_ZIP_TOO_MANY_FILES",
      "missingRootIndexHtml": "LD_ZIP_MISSING_ROOT_INDEX_HTML"
    }
  },
  "files": {
    "codes": {
      "extensionNotAllowed": "LD_FILE_EXTENSION_NOT_ALLOWED"
    },
    "allowedExtensions": [
      ".html",
      ".htm",
      ".css",
      ".js",
      ".mjs",
      ".json",
      ".map",
      ".txt",
      ".svg",
      ".png",
      ".jpg",
      ".jpeg",
      ".gif",
      ".webp",
      ".avif",
      ".ico",
      ".woff",
      ".woff2",
      ".ttf",
      ".otf",
      ".mp3",
      ".mp4",
      ".webm",
      ".wasm"
    ],
    "blockedFilenames": [
      { "match": "exact", "value": ".env", "code": "LD_FILE_ENV_INCLUDED" },
      { "match": "prefix", "value": ".env.", "code": "LD_FILE_ENV_INCLUDED" },
      {
        "match": "exact",
        "value": "runtime-config.js",
        "code": "LD_FILE_RUNTIME_CONFIG_INCLUDED"
      }
    ],
    "blockedPathRules": [
      { "kind": "absolute-path", "code": "LD_PATH_ABSOLUTE" },
      { "kind": "parent-traversal", "code": "LD_PATH_PARENT_TRAVERSAL" },
      { "kind": "backslash-separator", "code": "LD_PATH_BACKSLASH" },
      { "kind": "control-character", "code": "LD_PATH_CONTROL_CHARACTER" },
      { "kind": "url-reinterpret", "code": "LD_PATH_URL_REINTERPRET" },
      { "kind": "non-normalized", "code": "LD_PATH_NOT_NORMALIZED" }
    ]
  },
  "assetPaths": {
    "disallowRootAbsolute": {
      "enabled": true,
      "code": "LD_ASSET_ROOT_ABSOLUTE"
    }
  },
  "runtimeEnv": {
    "attachSeparately": true,
    "browserObject": "window.__LETS_RUNTIME_ENV__",
    "forbidBundledSecrets": true,
    "guideAnchor": "runtime-env"
  },
  "frameworks": [
    {
      "key": "nextjs",
      "detect": {
        "configFiles": ["next.config.js", "next.config.mjs", "next.config.ts"],
        "dependencies": ["next"]
      },
      "expectedAssetPrefix": "./_next/",
      "guideAnchor": "nextjs",
      "checks": ["LD_NEXT_ASSET_PREFIX_UNEXPECTED"]
    },
    {
      "key": "vite",
      "detect": {
        "configFiles": ["vite.config.js", "vite.config.mjs", "vite.config.ts"],
        "dependencies": ["vite"]
      },
      "expectedAssetPrefix": "./assets/",
      "guideAnchor": "vite",
      "checks": ["LD_VITE_ASSET_PREFIX_UNEXPECTED"]
    },
    {
      "key": "plain-html",
      "detect": {
        "configFiles": [],
        "dependencies": []
      },
      "expectedAssetPrefix": null,
      "guideAnchor": "plain-html",
      "checks": []
    }
  ],
