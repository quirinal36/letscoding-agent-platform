    {
      "code": "LD_FILE_ENV_INCLUDED",
      "severity": "error",
      "waivable": false,
      "appliesTo": "zip",
      "titleKey": "file.envIncluded",
      "guideAnchor": "blocked-files"
    },
    {
      "code": "LD_PATH_BACKSLASH",
