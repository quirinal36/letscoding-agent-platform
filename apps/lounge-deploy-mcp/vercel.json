{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["icn1"],
  "rewrites": [
    { "source": "/mcp", "destination": "/api/mcp" },
    { "source": "/health", "destination": "/api/health" },
    { "source": "/ready", "destination": "/api/ready" }
  ],
  "functions": {
    "api/*.ts": {
      "maxDuration": 10,
      "memory": 512
    }
  }
}
