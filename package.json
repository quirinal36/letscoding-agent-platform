{
  "name": "letscoding-agent-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "11.21.0"
  },
  "workspaces": [
    "apps/*",
    "plugins/*",
    "packages/*",
    "tests/policy-contract",
    "tests/plugin-e2e",
    "tests/operations"
  ],
  "scripts": {
    "audit:dependencies": "pnpm audit --prod --audit-level high",
    "build": "pnpm --recursive --if-present run build",
    "check": "pnpm lint && pnpm format:check && pnpm build && pnpm typecheck && pnpm test",
    "ci": "pnpm verify:package-manager && pnpm verify:secrets && pnpm verify:plugin && pnpm check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "preinstall": "node scripts/verify-package-manager.mjs",
    "release:bundle": "node scripts/create-release-artifact.mjs",
    "test": "pnpm --recursive --if-present run test",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "verify:package-manager": "node scripts/verify-package-manager.mjs",
    "verify:plugin": "node scripts/validate-plugin-package.mjs",
    "verify:policy-change": "node scripts/verify-policy-change.mjs",
    "verify:secrets": "node scripts/verify-tracked-secrets.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
