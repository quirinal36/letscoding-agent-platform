# Copy this file to .env for local-only values.
# Do not commit secrets or environment-specific credentials.
LETS_ENV=dev
LETS_REVISION=local
LETS_MAX_BODY_BYTES=1048576
LETS_TOOL_TIMEOUT_MS=5000
LETS_RATE_LIMIT_MAX_REQUESTS=120
LETS_RATE_LIMIT_WINDOW_MS=60000
LETS_MAX_CONCURRENT_REQUESTS=8
# LETS_NETWORK_KEY_SECRET is required remotely; never commit a real value.
